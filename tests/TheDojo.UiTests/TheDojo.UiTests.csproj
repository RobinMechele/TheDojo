<Project Sdk="Microsoft.NET.Sdk">

  <!--
    In-process UI tests: the real WPF window and pages built off-screen on the sample world, with binding errors
    failing the test and rendered screenshots compared with the baselines in Snapshots/. Local only; see README.md.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same on-disk fixtures the unit tests use. -->
    <Compile Include="..\TheDojo.Tests\Fixtures\*.cs" Link="Fixtures\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TheDojo.Core\TheDojo.Core.csproj" />
    <ProjectReference Include="..\..\src\TheDojo\TheDojo.csproj" />
  </ItemGroup>

</Project>
