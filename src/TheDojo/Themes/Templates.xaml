<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:TheDojo.ViewModels"
                    xmlns:controls="clr-namespace:TheDojo.Controls"
                    xmlns:local="clr-namespace:TheDojo">

    <local:VisibleWhenConverter x:Key="VisibleWhen" />

    <!-- A key figure: label, value, context line -->
    <DataTemplate DataType="{x:Type vm:StatTile}">
        <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,12,12" MinWidth="150">
            <StackPanel>
                <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" />
                <TextBlock Text="{Binding Value}" Style="{StaticResource StatValue}" />
                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,2,0,0"
                           Visibility="{Binding Detail, Converter={StaticResource VisibleWhen}}" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- A ranked row: name and value above a share bar, with a muted detail -->
    <DataTemplate DataType="{x:Type vm:RankRow}">
        <Grid Margin="0,0,0,12" ToolTip="{Binding Detail}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource Swatch}" Background="{Binding Fill}" />
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" Margin="12,0,0,0" />
            <controls:ShareBar Grid.Row="1" Grid.ColumnSpan="2" Height="5" Margin="0,6,0,0" Value="{Binding Share}" Fill="{Binding Fill}" />
        </Grid>
    </DataTemplate>

    <!-- A lesson from the coach: severity icon + label, what was seen, what to try -->
    <DataTemplate x:Key="LessonTemplate" DataType="{x:Type vm:InsightItem}">
        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource SurfaceRaisedBrush}" VerticalAlignment="Top" Margin="0,0,14,0">
                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Foreground="{Binding Brush}" HorizontalAlignment="Center" FontSize="14" />
                </Border>
                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SeverityText}" Style="{StaticResource Label}" />
                        <TextBlock Text="·" Style="{StaticResource Label}" Margin="5,0" />
                        <TextBlock Text="{Binding Category}" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding SavingsText}" Style="{StaticResource Label}" Foreground="{StaticResource AccentBrush}" Margin="10,0,0,0"
                                   Visibility="{Binding SavingsText, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,4" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Try" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="{Binding Action}" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- Live limits for one agent -->
    <DataTemplate DataType="{x:Type vm:ProviderLimitsItem}">
        <StackPanel Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Border Style="{StaticResource Swatch}" Background="{Binding Brush}" />
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Plan}" Style="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding Error}" Style="{StaticResource Muted}" TextWrapping="Wrap" Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}" />
            <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="{Binding Note, Converter={StaticResource VisibleWhen}}" />
            <ItemsControl ItemsSource="{Binding Windows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:LimitRowItem}">
                        <Grid Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" />
                            <TextBlock Grid.Column="1" Text="{Binding UsedText}" FontWeight="SemiBold" />
                            <controls:Meter Grid.Row="1" Grid.ColumnSpan="2" Height="8" Margin="0,6,0,6" Value="{Binding PercentUsed}" Marker="{Binding Elapsed}" />
                            <TextBlock Grid.Row="2" Text="{Binding ResetsText}" Style="{StaticResource Muted}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PaceText}" Style="{StaticResource Muted}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DataTemplate>

    <!-- A prompt and what it cost -->
    <DataTemplate x:Key="PromptTemplate" DataType="{x:Type vm:PromptItem}">
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="3" CornerRadius="2" Background="{Binding Brush}" Margin="0,2,10,2" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Preview}" />
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="{Binding When}" Style="{StaticResource Muted}" />
                    <TextBlock Text="·" Style="{StaticResource Muted}" Margin="5,0" />
                    <TextBlock Text="{Binding Project}" Style="{StaticResource Muted}" />
                    <TextBlock Text="·" Style="{StaticResource Muted}" Margin="5,0" />
                    <TextBlock Text="{Binding Work}" Style="{StaticResource Muted}" />
                </StackPanel>
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding Cost}" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
        </Grid>
    </DataTemplate>

    <!-- Ranked list with a title, or a muted line when empty -->
    <Style x:Key="RankList" TargetType="ItemsControl">
        <Setter Property="Focusable" Value="False" />
    </Style>
</ResourceDictionary>
