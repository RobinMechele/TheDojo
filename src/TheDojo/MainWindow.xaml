<Window x:Class="TheDojo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TheDojo.ViewModels"
        xmlns:views="clr-namespace:TheDojo.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="The Dojo" Width="1440" Height="920" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}"><views:OverviewView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CoachViewModel}"><views:CoachView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SessionsViewModel}"><views:SessionsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModelsViewModel}"><views:ModelsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProjectsViewModel}"><views:ProjectsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ToolsViewModel}"><views:ToolsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ActivityViewModel}"><views:ActivityView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LimitsViewModel}"><views:LimitsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}"><views:ReportsView /></DataTemplate>

        <!-- Period picker: a row of segments bound to an index -->
        <Style x:Key="SegmentList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="11,5" MinWidth="40">
                                        <ContentPresenter HorizontalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,20,14,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,26">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentDimBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                        <TextBlock Text="道" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="The Dojo" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="learn from your agents" Style="{StaticResource Muted}" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <!-- Belt, always in view -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="12,10" Cursor="Hand"
                        AutomationProperties.AutomationId="BeltCard"
                        ToolTip="Your Dojo score for the selected period. Open the coach to see how it's made up.">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateCommand}" CommandParameter="{Binding Pages[1]}" />
                    </Border.InputBindings>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="8" CornerRadius="2" Background="{Binding Overview.BeltBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock FontWeight="SemiBold"><Run Text="{Binding Overview.Belt, Mode=OneWay}" /><Run Text=" belt" /></TextBlock>
                            <TextBlock Style="{StaticResource Muted}"><Run Text="Score " /><Run Text="{Binding Overview.Score, Mode=OneWay}" /><Run Text=" / 100" /></TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Pages}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PageViewModel}">
                            <RadioButton Style="{StaticResource NavRadio}" GroupName="Nav" Margin="0,0,0,2"
                                         IsChecked="{Binding IsSelected, Mode=OneWay}"
                                         AutomationProperties.AutomationId="{Binding Page}"
                                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                         CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Width="18" Margin="4,0,10,0" />
                                    <TextBlock Text="{Binding Title}" />
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Main -->
        <Grid Grid.Column="1">
            <Border Background="{StaticResource GlowBrush}" IsHitTestVisible="False" />
            <DockPanel Margin="28,20,28,0">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Current.Title}" Style="{StaticResource H1}" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" AutomationProperties.AutomationId="Status" />
                            <TextBlock Text=" · loading…" Style="{StaticResource Muted}" Foreground="{StaticResource AccentBrush}"
                                       Visibility="{Binding IsLoading, Converter={StaticResource VisibleWhen}}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource SegmentHost}">
                            <ListBox Style="{StaticResource SegmentList}" ItemsSource="{x:Static vm:MainViewModel.RangeNames}"
                                     SelectedIndex="{Binding RangeIndex}" AutomationProperties.AutomationId="Range" />
                        </Border>
                        <ComboBox Width="130" Margin="10,0,0,0" ItemsSource="{x:Static vm:MainViewModel.ProviderNames}" SelectedIndex="{Binding ProviderIndex}"
                                  AutomationProperties.AutomationId="Provider" ToolTip="Which agent" />
                        <ComboBox Width="170" Margin="8,0,0,0" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"
                                  AutomationProperties.AutomationId="Project" ToolTip="Which project" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="8,0,0,0" Command="{Binding RefreshCommand}"
                                ToolTip="Refresh (F5)" AutomationProperties.AutomationId="Refresh" />
                    </StackPanel>
                </Grid>

                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14,9" Margin="0,10,0,0" AutomationProperties.AutomationId="UpdateBanner"
                        Visibility="{Binding Update.IsAvailable, Converter={StaticResource VisibleWhen}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Update.Message}" TextWrapping="Wrap" />
                            <ProgressBar Height="3" Margin="0,6,0,0" Minimum="0" Maximum="1" Value="{Binding Update.Progress, Mode=OneWay}"
                                         Visibility="{Binding Update.IsInstalling, Converter={StaticResource VisibleWhen}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button Content="Update and restart" Style="{StaticResource PrimaryButton}" Command="{Binding Update.InstallCommand}"
                                    AutomationProperties.AutomationId="UpdateInstall" />
                            <Button Content="Later" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Command="{Binding Update.DismissCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border DockPanel.Dock="Top" Background="#33D03B3B" CornerRadius="8" Padding="12,8" Margin="0,10,0,0"
                        Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
                </Border>

                <ContentControl Content="{Binding Current}" Margin="0,16,0,0" Focusable="False" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
