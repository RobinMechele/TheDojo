<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>TheDojo</RootNamespace>
    <AssemblyName>TheDojo</AssemblyName>
    <AssemblyTitle>The Dojo</AssemblyTitle>
    <Description>Learn from your AI agent usage: tokens, cost, limits and behaviour.</Description>
    <ApplicationIcon>Assets\TheDojo.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TheDojo.UiTests" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TheDojo.Core\TheDojo.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\TheDojo.ico" />
  </ItemGroup>

</Project>
