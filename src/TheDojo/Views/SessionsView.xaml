<UserControl x:Class="TheDojo.Views.SessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TheDojo.ViewModels"
             xmlns:controls="clr-namespace:TheDojo.Controls"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:SessionsViewModel}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="460" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <DockPanel Margin="0,0,0,20">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <Grid Width="320" HorizontalAlignment="Left">
                    <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="SessionSearch" ToolTip="Search by title, project, branch or model" />
                    <TextBlock Text="Search sessions" Style="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding Search, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" />
                </Grid>
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Border Style="{StaticResource Card}" Padding="6,10,6,4">
                <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutomationProperties.AutomationId="SessionGrid">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Session" Width="2*" MinWidth="170" SortMemberPath="Title">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource Swatch}" Background="{Binding Brush}" ToolTip="{Binding Agent}" />
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource CellText}" ToolTip="{Binding Title}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Project" Binding="{Binding Project}" Width="*" MinWidth="80" ElementStyle="{StaticResource CellMuted}" />
                        <DataGridTextColumn Header="Started" Binding="{Binding StartText}" SortMemberPath="Start" Width="92" ElementStyle="{StaticResource CellMuted}" />
                        <DataGridTextColumn Header="Prompts" Binding="{Binding Prompts}" Width="74" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource RightHeader}" />
                        <DataGridTextColumn Header="Context" Binding="{Binding PeakContextText}" SortMemberPath="PeakContext" Width="66" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource RightHeader}" />
                        <DataGridTextColumn Header="Per prompt" Binding="{Binding PerPromptText}" SortMemberPath="PerPrompt" Width="90" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource RightHeader}" />
                        <DataGridTextColumn Header="Spend" Binding="{Binding CostText}" SortMemberPath="Cost" Width="80" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource RightHeader}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <!-- Detail of the selected session -->
        <Border Grid.Column="1" Width="470" Margin="14,0,0,20" Style="{StaticResource Card}" Padding="20,16"
                Visibility="{Binding Detail, Converter={StaticResource VisibleWhen}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Detail}" Padding="0,0,6,0">
                <StackPanel d:DataContext="{d:DesignInstance vm:SessionDetailViewModel}">
                    <Grid>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,0,34,0" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Command="{Binding DataContext.CloseDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" ToolTip="Close" />
                    </Grid>
                    <TextBlock Text="{Binding Meta}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,14" />

                    <ItemsControl ItemsSource="{Binding Tiles}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock Text="Context per call" Style="{StaticResource CardTitle}" Margin="0,6,0,4" Visibility="{Binding HasContext, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Text="How full the context window was on every message. A rising line is a session getting more expensive per message; drops are compactions."
                               Style="{StaticResource Muted}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,8" Visibility="{Binding HasContext, Converter={StaticResource VisibleWhen}}" />
                    <controls:LineChart Height="180" Series="{Binding Context}" Format="Tokens" ShowMarkers="False" Margin="0,0,0,16"
                                        Visibility="{Binding HasContext, Converter={StaticResource VisibleWhen}}" />

                    <TextBlock Text="{Binding Errors}" Style="{StaticResource Muted}" Margin="0,0,0,12" Visibility="{Binding Errors, Converter={StaticResource VisibleWhen}}" />

                    <TextBlock Text="Prompts" Style="{StaticResource CardTitle}" />
                    <ItemsControl ItemsSource="{Binding Prompts}" ItemTemplate="{StaticResource PromptTemplate}" Focusable="False" Margin="0,0,0,10" />

                    <TextBlock Text="Tools" Style="{StaticResource CardTitle}" Visibility="{Binding Tools, Converter={StaticResource VisibleWhen}}" />
                    <ItemsControl ItemsSource="{Binding Tools}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ToolItem}">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <controls:ShareBar Grid.Column="1" Height="5" Value="{Binding Share}" Fill="{StaticResource SeriesBlueBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource Muted}" HorizontalAlignment="Right"><Run Text="{Binding Calls, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Errors, Mode=OneWay}" /><Run Text=" failed" /></TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Pull requests" Style="{StaticResource CardTitle}" Margin="0,10,0,6" Visibility="{Binding PullRequests, Converter={StaticResource VisibleWhen}}" />
                    <ItemsControl ItemsSource="{Binding PullRequests}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Secondary}" Margin="0,0,0,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
