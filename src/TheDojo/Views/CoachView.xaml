<UserControl x:Class="TheDojo.Views.CoachView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TheDojo.ViewModels"
             xmlns:controls="clr-namespace:TheDojo.Controls"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:CoachViewModel}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,24">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Dojo score" Style="{StaticResource Label}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                            <TextBlock Text="{Binding Score}" Style="{StaticResource Hero}" />
                            <TextBlock Text="/ 100" Style="{StaticResource Muted}" Margin="8,0,0,12" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="56" Height="12" CornerRadius="2" Background="{Binding BeltBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" VerticalAlignment="Center" />
                            <TextBlock Margin="10,0,0,0" FontSize="15" FontWeight="SemiBold"><Run Text="{Binding Belt, Mode=OneWay}" /><Run Text=" belt" /></TextBlock>
                        </StackPanel>
                        <TextBlock Text="{Binding NextBelt}" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="How the score is made" Style="{StaticResource CardTitle}" />
                        <ItemsControl ItemsSource="{Binding Parts}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ScorePartItem}">
                                    <StackPanel Margin="0,0,0,14">
                                        <Grid>
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Text="{Binding ValueText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        </Grid>
                                        <controls:Meter Height="6" Margin="0,6,0,6" Value="{Binding Value}" HigherIsBetter="True" />
                                        <TextBlock Text="{Binding Explanation}" Style="{StaticResource Muted}" TextWrapping="Wrap" TextTrimming="None" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Not enough activity in this period to score." Style="{StaticResource Muted}"
                                   Visibility="{Binding Parts, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" Text="{Binding Savings}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,0,10"
                       Visibility="{Binding Savings, Converter={StaticResource VisibleWhen}}" />
            <TextBlock DockPanel.Dock="Top" Text="No lessons for this period yet. Use your agents for a while, or pick a longer period."
                       Style="{StaticResource Secondary}" Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,24">
                <ItemsControl ItemsSource="{Binding Insights}" ItemTemplate="{StaticResource LessonTemplate}" Focusable="False" AutomationProperties.AutomationId="Lessons" />
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
